<svg width="600" height="500" viewBox="0 0 600 500" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="600" height="500" fill="#F8F9FA"/>

  <!-- Grid pattern -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#E5E7EB" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="600" height="500" fill="url(#grid)"/>

  <!-- Central network hub -->
  <g transform="translate(200, 100)">
    <!-- Central circle -->
    <circle cx="100" cy="120" r="40" stroke="#0076FF" stroke-width="3" fill="none"/>

    <!-- Network nodes -->
    <circle cx="100" cy="40" r="20" stroke="#0076FF" stroke-width="2" fill="none"/>
    <circle cx="180" cy="80" r="20" stroke="#0076FF" stroke-width="2" fill="none"/>
    <circle cx="180" cy="160" r="20" stroke="#0076FF" stroke-width="2" fill="none"/>
    <circle cx="100" cy="200" r="20" stroke="#0076FF" stroke-width="2" fill="none"/>
    <circle cx="20" cy="160" r="20" stroke="#0076FF" stroke-width="2" fill="none"/>
    <circle cx="20" cy="80" r="20" stroke="#0076FF" stroke-width="2" fill="none"/>

    <!-- Connection lines -->
    <line x1="100" y1="80" x2="100" y2="60" stroke="#0076FF" stroke-width="2" opacity="0.5"/>
    <line x1="140" y1="120" x2="160" y2="80" stroke="#0076FF" stroke-width="2" opacity="0.5"/>
    <line x1="140" y1="120" x2="160" y2="160" stroke="#0076FF" stroke-width="2" opacity="0.5"/>
    <line x1="100" y1="160" x2="100" y2="180" stroke="#0076FF" stroke-width="2" opacity="0.5"/>
    <line x1="60" y1="120" x2="40" y2="160" stroke="#0076FF" stroke-width="2" opacity="0.5"/>
    <line x1="60" y1="120" x2="40" y2="80" stroke="#0076FF" stroke-width="2" opacity="0.5"/>

    <!-- Central icon (server/monitor) -->
    <rect x="80" y="105" width="40" height="30" rx="3" stroke="#0076FF" stroke-width="2" fill="none"/>
    <line x1="100" y1="135" x2="100" y2="145" stroke="#0076FF" stroke-width="2"/>
    <line x1="90" y1="145" x2="110" y2="145" stroke="#0076FF" stroke-width="2"/>
  </g>

  <!-- Decorative elements -->
  <circle cx="80" cy="80" r="15" stroke="#0076FF" stroke-width="2" fill="none" opacity="0.3"/>
  <circle cx="520" cy="420" r="25" stroke="#0076FF" stroke-width="2" fill="none" opacity="0.3"/>
  <rect x="490" y="60" width="60" height="60" rx="6" stroke="#0076FF" stroke-width="2" fill="none" opacity="0.3"/>

  <!-- Text placeholder -->
  <text x="300" y="450" font-family="Arial, sans-serif" font-size="18" fill="#6B7280" text-anchor="middle">
    Managed Service Provider Partnership
  </text>
</svg>
