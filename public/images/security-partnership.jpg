<svg width="600" height="500" viewBox="0 0 600 500" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="600" height="500" fill="#F8F9FA"/>

  <!-- Grid pattern -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#E5E7EB" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="600" height="500" fill="url(#grid)"/>

  <!-- Central shield icon -->
  <g transform="translate(200, 100)">
    <!-- Shield outline -->
    <path d="M100 0C100 0 20 20 20 60V140C20 200 100 240 100 240C100 240 180 200 180 140V60C180 20 100 0 100 0Z"
          stroke="#0076FF" stroke-width="4" fill="none"/>

    <!-- Lock in center -->
    <rect x="80" y="100" width="40" height="50" rx="4" stroke="#0076FF" stroke-width="3" fill="none"/>
    <path d="M85 100V85C85 76.7157 91.7157 70 100 70C108.284 70 115 76.7157 115 85V100"
          stroke="#0076FF" stroke-width="3" fill="none"/>
    <circle cx="100" cy="125" r="5" fill="#0076FF"/>

    <!-- Connecting nodes -->
    <circle cx="50" cy="80" r="8" fill="#0076FF" opacity="0.6"/>
    <circle cx="150" cy="80" r="8" fill="#0076FF" opacity="0.6"/>
    <circle cx="50" cy="160" r="8" fill="#0076FF" opacity="0.6"/>
    <circle cx="150" cy="160" r="8" fill="#0076FF" opacity="0.6"/>

    <!-- Connection lines -->
    <line x1="50" y1="80" x2="100" y2="60" stroke="#0076FF" stroke-width="2" opacity="0.4"/>
    <line x1="150" y1="80" x2="100" y2="60" stroke="#0076FF" stroke-width="2" opacity="0.4"/>
    <line x1="50" y1="160" x2="100" y2="180" stroke="#0076FF" stroke-width="2" opacity="0.4"/>
    <line x1="150" y1="160" x2="100" y2="180" stroke="#0076FF" stroke-width="2" opacity="0.4"/>
  </g>

  <!-- Decorative elements -->
  <circle cx="80" cy="80" r="20" stroke="#0076FF" stroke-width="2" fill="none" opacity="0.3"/>
  <circle cx="520" cy="420" r="30" stroke="#0076FF" stroke-width="2" fill="none" opacity="0.3"/>
  <rect x="480" y="60" width="80" height="80" rx="8" stroke="#0076FF" stroke-width="2" fill="none" opacity="0.3"/>

  <!-- Text placeholder -->
  <text x="300" y="450" font-family="Arial, sans-serif" font-size="18" fill="#6B7280" text-anchor="middle">
    Cybersecurity Partnership
  </text>
</svg>
